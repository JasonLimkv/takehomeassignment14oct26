@page
@model OneST.Web.Pages.WeatherModel
@{
    ViewData["Title"] = "Weather forecast";
}
<h1 class="h3 mb-4">Singapore weather</h1>
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    <a asp-page="/Weather" class="btn btn-outline-light">Try again</a>
}
else
{
    <form id="weather-form" method="get" asp-page="/Weather"
          data-forecast-url="@Url.Page("/Weather", "Forecast")" class="mb-4">
        <label for="Location" class="form-label fw-semibold">Location</label>
        <div class="d-flex flex-column flex-sm-row gap-2">
            <select id="Location" name="location" class="form-select" aria-describedby="weather-status" required>
                <option value="">Choose a location</option>
                @foreach (var area in Model.Locations)
                {
                    <option value="@area.Area" selected="@(Model.Location == area.Area)">@area.Area</option>
                }
            </select>
            <button type="submit" class="btn btn-primary flex-shrink-0" disabled>Show forecast</button>
        </div>
    </form>
    <p id="weather-status" class="small text-body-secondary" role="status"></p>
    <section id="weather-result" class="border-top pt-4" aria-labelledby="forecast-heading" hidden>
        <h2 id="forecast-heading" class="h5"></h2>
        <p id="forecast-description" class="fs-4 mb-2"></p>
        <p id="forecast-period" class="small text-body-secondary"></p>
    </section>
    <noscript><p class="text-warning">JavaScript is required to display forecasts on this page.</p></noscript>
}
<p class="small text-body-secondary mt-4">
    Source: <a href="https://data.gov.sg/datasets/d_3f9e064e25005b0e42969944ccaf2e7a/view">NEA / data.gov.sg</a>
</p>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("weather-form");
            if (!form) return;

            const select = document.getElementById("Location");
            const button = form.querySelector('button[type="submit"]');
            const status = document.getElementById("weather-status");
            const result = document.getElementById("weather-result");
            const heading = document.getElementById("forecast-heading");
            const description = document.getElementById("forecast-description");
            const period = document.getElementById("forecast-period");
            const timeFormat = new Intl.DateTimeFormat("en-SG", {
                timeZone: "Asia/Singapore", dateStyle: "medium", timeStyle: "short"
            });

            form.addEventListener("submit", async event => {
                event.preventDefault();
                if (button.disabled) return;

                const url = new URL(form.dataset.forecastUrl, window.location.href);
                url.searchParams.set("location", select.value);
                button.disabled = true;
                select.disabled = true;
                button.textContent = "Loading...";
                form.setAttribute("aria-busy", "true");
                result.hidden = true;
                status.className = "small text-body-secondary";
                status.textContent = "Loading forecast...";

                try {
                    const response = await fetch(url, {
                        headers: { "Accept": "application/json" },
                        cache: "no-store",
                        signal: AbortSignal.timeout(15000)
                    });
                    const data = await response.json();

                    if (!response.ok) {
                        status.className = "small text-danger";
                        status.textContent = typeof data?.message === "string"
                            ? data.message : "Could not load the forecast. Please try again.";
                        return;
                    }

                    const start = new Date(data?.start);
                    const end = new Date(data?.end);
                    if (typeof data?.area !== "string" || typeof data?.forecast !== "string"
                        || typeof data?.start !== "string" || typeof data?.end !== "string"
                        || !Number.isFinite(start.getTime()) || !Number.isFinite(end.getTime())) {
                        throw new Error("Invalid forecast response.");
                    }

                    heading.textContent = data.area;
                    description.textContent = data.forecast;
                    period.textContent = `Valid ${timeFormat.format(start)} - ${timeFormat.format(end)} (SGT)`;
                    result.hidden = false;
                    status.textContent = `Forecast updated for ${data.area}.`;

                    const pageUrl = new URL(form.action);
                    pageUrl.searchParams.set("location", data.area);
                    window.history.replaceState(null, "", pageUrl);
                } catch {
                    status.className = "small text-danger";
                    status.textContent = "Could not load the forecast. Please try again.";
                } finally {
                    button.disabled = false;
                    select.disabled = false;
                    button.textContent = "Show forecast";
                    form.removeAttribute("aria-busy");
                }
            });

            button.disabled = false;
            if (select.value) form.requestSubmit();
        })();
    </script>
}
