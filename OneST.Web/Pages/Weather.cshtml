@page
@model OneST.Web.Pages.WeatherModel
@using System.Text.Json
@{
    ViewData["Title"] = "Weather forecast";
    var weatherData = JsonSerializer.Serialize(new
    {
        forecasts = Model.Locations,
        metadata = Model.AreaMetadata,
        start = Model.CurrentForecast?.ValidPeriod?.Start,
        end = Model.CurrentForecast?.ValidPeriod?.End
    });
}

<div id="weather-app" data-weather="@weatherData">
    <div class="weather-page-heading">
        <h1>Singapore weather</h1>
        <p>2-hour forecast</p>
    </div>

    <div class="weather-layout">
        <figure class="weather-map-figure">
            <div id="weather-map" class="weather-map" role="group" aria-label="Singapore forecast locations">
                <img id="singapore-map" src="~/images/singapore.svg" asp-append-version="true"
                     width="1000" height="620" alt="Map of Singapore and its surrounding islands"
                     draggable="false" />
                <div id="weather-markers" class="weather-markers"></div>
                <span class="weather-map-north" aria-hidden="true">N</span>
            </div>
            <figcaption class="weather-map-caption">
                <span id="weather-map-count"></span>
                <span>Map: <a href="https://data.gov.sg/datasets/d_2cc750190544007400b2cfd5d7f53209/view">URA</a>
                    / <a href="https://data.gov.sg/open-data-licence">Licence</a></span>
            </figcaption>
            <p id="weather-map-status" class="weather-map-status" role="status"></p>
        </figure>

        <div class="weather-detail">
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
                <a asp-page="/Weather" class="btn btn-outline-light">Try again</a>
            }
            else
            {
                <form id="weather-form" method="get" asp-page="/Weather"
                      data-forecast-url="@Url.Page("/Weather", "Forecast")">
                    <label for="Location" class="form-label">Location</label>
                    <div id="location-search" class="location-search">
                        <input id="Location" name="location" value="@Model.Location" type="text"
                               class="form-control" placeholder="Search locations" autocomplete="off"
                               spellcheck="false" role="combobox" aria-autocomplete="list"
                               aria-expanded="false" aria-controls="location-options"
                               aria-describedby="location-search-status" required />
                        <div id="location-popup" class="location-popup" hidden>
                            <div id="location-options" role="listbox" aria-label="Locations">
                                @for (var index = 0; index < Model.Locations.Count; index++)
                                {
                                    var area = Model.Locations[index];
                                    <button id="location-option-@index" type="button" class="location-option"
                                            role="option" aria-selected="false" tabindex="-1"
                                            data-value="@area.Area">@area.Area</button>
                                }
                            </div>
                            <p id="location-no-results" class="location-no-results" hidden>No matching locations.</p>
                        </div>
                    </div>
                    <p id="location-search-status" class="visually-hidden" role="status"></p>
                    <button type="submit" class="weather-refresh" disabled>Refresh forecast</button>
                </form>

                <p id="weather-status" class="weather-status" role="status"></p>
                <div class="weather-forecast-body">
                    <p id="weather-empty" class="text-body-secondary">Choose a location.</p>
                    <section id="weather-result" aria-labelledby="forecast-heading" hidden>
                        <h2 id="forecast-heading"></h2>
                        <p id="forecast-description"></p>
                        <p class="weather-period-label">Valid period (SGT)</p>
                        <p id="forecast-period"></p>
                    </section>
                </div>
                <noscript><p>JavaScript is required to display forecasts on this page.</p></noscript>
            }
            <p class="weather-source">Forecasts: <a href="https://data.gov.sg/datasets/d_3f9e064e25005b0e42969944ccaf2e7a/view">NEA / data.gov.sg</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/d3/d3.min.js" asp-append-version="true"></script>
    <script src="~/js/weather.js" asp-append-version="true"></script>
}
